<mxfile host="app.diagrams.net">
  <diagram id="costloupe-app-arch" name="Costloupe App architecture">
    <mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="browser" value="web browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="frontZone" value="Frontend - React" style="rounded=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="230" height="320" as="geometry" />
        </mxCell>
        <mxCell id="backZone" value="Backend - FastAPI" style="rounded=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="540" height="320" as="geometry" />
        </mxCell>
        <mxCell id="wizard" value="wizard&#10;(questionnaire)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
